# Saved sweep parameters and zoom settings. Per-user, rewritten on every
# exit -- not something to share or to keep in history.
sweep_design_state.json

# The user's saved vibrators. Unlike the state file this one is worth
# keeping and copying between machines, but it describes whatever fleet the
# person running the program works with -- it is their data, not the app's.
sweep_design_vibrators.json

# Local tool configuration; contains absolute paths from the machine it was
# written on.
.claude/

# Ad-hoc exports from the Export button. docs/example.png is generated
# deliberately and IS tracked; these are whatever was on screen at the time.
sweep_comparison_*.svg
sweep_comparison_*.png

# Ad-hoc exports from Traces (data)... The file dialog opens in the program
# folder, so these land here by default. They are somebody's working data,
# and a .sgy is large; the repo should never hold either. Note none of these
# patterns matches sweep_export.py, which is source and IS tracked.
sweep_export_*.txt
/*.sgy
/*.segy
/*.wlt

# PyInstaller output (see BUILD.md)
build/
dist/
*.manifest

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# An unpacked release downloaded here for testing, and its zip. These are
# build OUTPUT; committing them once put 68 MB and 1221 files into a commit.
SweepDesign/
SweepDesign-*.zip
selftest.txt

# Screenshots dropped in for review.
Screenshot_*.png
